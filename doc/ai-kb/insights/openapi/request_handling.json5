{
  request_handling: {
    request_structure: {
      insights: [
        {
          topic: "Request Body Structure",
          insight: "Use a dedicated struct for JSON body to avoid tag conflicts",
          example: `
            type CreatePetRequest struct {
              Pet CreatePetRequestPet 'in:"body=json"'
            }
            type CreatePetRequestPet struct {
              Name string 'json:"name"'
            }
          `,
          reasons: [
            "Separates routing/binding concerns from data structure",
            "Avoids conflicts between 'in' and 'json' tags",
            "Makes schema generation cleaner"
          ]
        },
        {
          topic: "Mixed Parameter Types",
          insight: "Combine path, query, and body parameters in a single struct",
          example: `
            type UpdatePetRequest struct {
              ID  int64 'in:"path=id"'
              Pet UpdatePetBody 'in:"body=json"'
            }
          `,
          benefits: [
            "Single point of request validation",
            "Clear parameter documentation",
            "Type-safe request handling"
          ]
        }
      ]
    },
    parameter_handling: {
      insights: [
        {
          topic: "Path Parameters",
          insight: "Path parameters are automatically marked as required",
          example: "ID int64 'in:\"path=id\"'",
          rules: [
            "Always required (Required=true)",
            "Must match path template",
            "Type conversion handled by httpin"
          ]
        },
        {
          topic: "Query Parameters",
          insight: "Query parameters support arrays and optional values",
          example: "Tags []string 'in:\"query=tags\"'",
          features: [
            "Array parsing (comma-separated)",
            "Optional by default",
            "Type conversion"
          ]
        }
      ]
    }
  }
}
